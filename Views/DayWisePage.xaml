<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IPOProcessingSystem.ViewModels"
             xmlns:models="clr-namespace:IPOProcessingSystem.Models"
             x:Class="IPOProcessingSystem.Views.DayWisePage"
             x:DataType="vm:DayWiseViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Day Wise Process" Style="{StaticResource SectionHeader}" />

            <!-- Exchange + ASBA Type -->
            <HorizontalStackLayout Spacing="16">
                <Label Text="Stock Exchange" VerticalOptions="Center" />
                <RadioButton Content="NSE" GroupName="DWExch"
                             IsChecked="{Binding Exchange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NSE}" />
                <RadioButton Content="BSE" GroupName="DWExch"
                             IsChecked="{Binding Exchange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BSE}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="16">
                <Label Text="ASBA Type" VerticalOptions="Center" />
                <RadioButton Content="Member ASBA" GroupName="DWAsba"
                             IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='MEMBER ASBA'}" />
                <RadioButton Content="Bank ASBA" GroupName="DWAsba"
                             IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BANK ASBA'}" />
            </HorizontalStackLayout>

            <!-- File Browse + Upload -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding FilePath}" Placeholder="Bid file path" IsReadOnly="True" />
                <Button Grid.Column="1" Text="Browse" Command="{Binding BrowseCommand}" />
            </Grid>

            <!-- Day selector -->
            <HorizontalStackLayout Spacing="12">
                <Label Text="Select Day" VerticalOptions="Center" />
                <Picker ItemsSource="{Binding DayOptions}" SelectedItem="{Binding SelectedDay}"
                        WidthRequest="80" />
            </HorizontalStackLayout>

            <!-- Action Buttons Row 1 -->
            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                <Button Text="Upload" Command="{Binding UploadCommand}" Margin="4" />
                <Button Text="Process" Command="{Binding ProcessCommand}" Margin="4" />
                <Button Text="Map IFSC" Command="{Binding MapIfscCommand}" Margin="4" />
                <Button Text="Day Wise Data" Command="{Binding GenerateDayWiseDataCommand}" Margin="4" />
                <Button Text="Email To Banks" Command="{Binding EmailToBanksCommand}" BackgroundColor="#D62828" Margin="4" />
            </FlexLayout>

            <!-- Totals -->
            <HorizontalStackLayout Spacing="24">
                <Label Text="{Binding TotalRecords, StringFormat='Records: {0}'}" />
                <Label Text="{Binding TotalQuantity, StringFormat='Quantity: {0}'}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Accent}" />
        </VerticalStackLayout>

        <!-- Preview grid -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding PreviewRows}">
            <CollectionView.Header>
                <Grid ColumnDefinitions="80,100,90,90,90,90" Padding="4" BackgroundColor="{StaticResource Primary}">
                    <Label Text="IPO ID" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Client ID" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="Order No" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="3" Text="Symbol" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="4" Text="Qty" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="5" Text="Bank Code" TextColor="White" FontAttributes="Bold" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ApplnsxBid">
                    <Grid ColumnDefinitions="80,100,90,90,90,90" Padding="4">
                        <Label Text="{Binding IPO_ID}" />
                        <Label Grid.Column="1" Text="{Binding ClientId}" />
                        <Label Grid.Column="2" Text="{Binding OrderNo}" />
                        <Label Grid.Column="3" Text="{Binding Symbol}" />
                        <Label Grid.Column="4" Text="{Binding Quantity}" />
                        <Label Grid.Column="5" Text="{Binding BankCode}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
