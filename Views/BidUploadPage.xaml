<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IPOProcessingSystem.ViewModels"
             x:Class="IPOProcessingSystem.Views.BidUploadPage"
             x:DataType="vm:BidUploadViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="700" HorizontalOptions="Center" VerticalOptions="Start">
            <Label Text="Bid File Upload" Style="{StaticResource SectionHeader}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,10,0,10" />

            <!-- ASBA Type Selection -->
            <VerticalStackLayout Spacing="8">
                <Label Text="ASBA Type" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="18">
                    <RadioButton Content="Bank ASBA" GroupName="Asba" IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BANK ASBA'}" />
                    <RadioButton Content="Member ASBA" GroupName="Asba" IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='MEMBER ASBA'}" />
                    <RadioButton Content="Mismatch ASBA" GroupName="Asba" IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='MISSMATCH ASBA'}" />
                    <RadioButton Content="NonBank ASBA" GroupName="Asba" IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='NONBANK ASBA'}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- File Browse -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Select Bid File" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding FilePath}" Placeholder="Click Browse to select file (.dat, .csv)..." IsReadOnly="True" />
                    <Button Grid.Column="1" Text="Browse" Command="{Binding BrowseCommand}" WidthRequest="90" />
                </Grid>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <HorizontalStackLayout Spacing="16" Margin="0,6,0,0" HorizontalOptions="Center">
                <Button Text="Upload" Command="{Binding UploadCommand}" BackgroundColor="{StaticResource Primary}" WidthRequest="120" />
                <Button Text="Clear Data" Command="{Binding ClearDataCommand}" BackgroundColor="{StaticResource Accent}" WidthRequest="120" />
            </HorizontalStackLayout>

            <!-- Summary Status -->
            <Border Stroke="#CCCCCC" StrokeThickness="1" Padding="16" Margin="0,10,0,0" BackgroundColor="#F9F9F9">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Upload Summary" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="Total Records:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalRecords, StringFormat='{0:N0}'}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Total Quantity:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalQuantity, StringFormat='{0:N0}'}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Accent}" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
