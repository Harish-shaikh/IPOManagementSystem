<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IPOProcessingSystem.ViewModels"
             xmlns:models="clr-namespace:IPOProcessingSystem.Models"
             x:Class="IPOProcessingSystem.Views.BidUploadPage"
             x:DataType="vm:BidUploadViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <HorizontalStackLayout Spacing="16">
                <Label Text="Stock Exchange" VerticalOptions="Center" />
                <RadioButton Content="NSE" GroupName="Exch" IsChecked="{Binding Exchange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NSE}" />
                <RadioButton Content="BSE" GroupName="Exch" IsChecked="{Binding Exchange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BSE}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="16">
                <Label Text="ASBA Type" VerticalOptions="Center" />
                <RadioButton Content="Bank ASBA" GroupName="Asba" IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BANK ASBA'}" />
                <RadioButton Content="Member ASBA" GroupName="Asba" IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='MEMBER ASBA'}" />
                <RadioButton Content="UPI ASBA" GroupName="Asba" IsChecked="{Binding AsbaType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='UPI ASBA'}" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding FilePath}" Placeholder="File path" IsReadOnly="True" />
                <Button Grid.Column="1" Text="Browse" Command="{Binding BrowseCommand}" />
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Upload" Command="{Binding UploadCommand}" />
                <Button Text="Clear Data" Command="{Binding ClearDataCommand}" BackgroundColor="{StaticResource Accent}" />
                <Button Text="Map Dummy IFSC" Command="{Binding MapDummyIfscCommand}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="24">
                <Label Text="{Binding TotalRecords, StringFormat='Total Records: {0}'}" />
                <Label Text="{Binding TotalQuantity, StringFormat='Total Quantity: {0}'}" />
            </HorizontalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Accent}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding PreviewRows}">
            <CollectionView.Header>
                <Grid ColumnDefinitions="70,110,80,70,70,70,90,70,80" Padding="4" BackgroundColor="{StaticResource Primary}">
                    <Label Text="IPO ID" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Client ID" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="Order No" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="3" Text="Book ID" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="4" Text="Branch" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="5" Text="User ID" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="6" Text="Symbol" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="7" Text="Qty" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="8" Text="Bank Code" TextColor="White" FontAttributes="Bold" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ApplnsxBid">
                    <Grid ColumnDefinitions="70,110,80,70,70,70,90,70,80" Padding="4">
                        <Label Text="{Binding IPO_ID}" />
                        <Label Grid.Column="1" Text="{Binding ClientId}" />
                        <Label Grid.Column="2" Text="{Binding OrderNo}" />
                        <Label Grid.Column="3" Text="{Binding BookId}" />
                        <Label Grid.Column="4" Text="{Binding Branch}" />
                        <Label Grid.Column="5" Text="{Binding UserId}" />
                        <Label Grid.Column="6" Text="{Binding Symbol}" />
                        <Label Grid.Column="7" Text="{Binding Quantity}" />
                        <Label Grid.Column="8" Text="{Binding BankCode}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
