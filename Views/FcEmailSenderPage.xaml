<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IPOProcessingSystem.ViewModels"
             xmlns:models="clr-namespace:IPOProcessingSystem.Models"
             x:Class="IPOProcessingSystem.Views.FcEmailSenderPage"
             x:DataType="vm:FcEmailSenderViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="FC Email Sender (Fund Transfer Letters)" Style="{StaticResource SectionHeader}" />

            <!-- Date Configuration & Mode Info -->
            <Border Stroke="{StaticResource Primary}" StrokeThickness="1" Padding="12" BackgroundColor="#FAFAFA">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Allotment Date:" FontSize="11" />
                            <DatePicker Date="{Binding AllotmentDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Letter Gen Date:" FontSize="11" />
                            <DatePicker Date="{Binding LetterGenDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                            <Label Text="{Binding ModeLabel}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="Load Banks" Command="{Binding LoadCommand}" />
                <Button Text="1. GENERATE REPORTS" Command="{Binding GenerateReportsCommand}" BackgroundColor="{StaticResource Primary}" />
                <Button Text="2. ABA RESOLUTION" Command="{Binding AbaResolutionCommand}" BackgroundColor="DarkOrange" />
                <Button Text="3. ZIP BANK-WISE" Command="{Binding ZipBankWiseCommand}" />
                <Button Text="4. EMAIL TO BANKS" Command="{Binding EmailToBanksCommand}" BackgroundColor="ForestGreen" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Accent}" FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- Status Collection -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding BankStatuses}">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,90,90,90,90,90" Padding="6" BackgroundColor="{StaticResource Primary}">
                    <Label Text="Bank Name" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Code" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="Letters Gen?" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="3" Text="ABA Done?" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="4" Text="ZIP Done?" TextColor="White" FontAttributes="Bold" />
                    <Label Grid.Column="5" Text="Email Sent?" TextColor="White" FontAttributes="Bold" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FcEmailStatus">
                    <Grid ColumnDefinitions="*,90,90,90,90,90" Padding="6">
                        <Label Text="{Binding BankName}" />
                        <Label Grid.Column="1" Text="{Binding BankCode}" />
                        <Label Grid.Column="2" Text="{Binding FundTransferDone}" />
                        <Label Grid.Column="3" Text="{Binding AbaResolutionDone}" />
                        <Label Grid.Column="4" Text="{Binding ZipDone}" />
                        <Label Grid.Column="5" Text="{Binding SendDone}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
