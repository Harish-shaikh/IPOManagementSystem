<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:IPOProcessingSystem.Services"
             x:Class="IPOProcessingSystem.Views.FooterView">
    <Border Stroke="#B0BEC5" StrokeThickness="1" BackgroundColor="#263238" Padding="12,6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="24">
            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Label Text="Active IPO ID:" TextColor="#90CAF9" FontAttributes="Bold" FontSize="12" />
                <Label x:Name="IpoIdLabel" Text="0" TextColor="White" FontAttributes="Bold" FontSize="12" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label Text="Client Name:" TextColor="#B0BEC5" FontSize="12" />
                <Label x:Name="ClientNameLabel" Text="None" TextColor="White" FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                <Label Text="Login By:" TextColor="#B0BEC5" FontSize="12" />
                <Label x:Name="LoginByLabel" Text="50216" TextColor="#A5D6A7" FontAttributes="Bold" FontSize="12" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                <Label Text="Version:" TextColor="#B0BEC5" FontSize="12" />
                <Label x:Name="VersionLabel" Text="1.0.0" TextColor="#FFE082" FontSize="12" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
