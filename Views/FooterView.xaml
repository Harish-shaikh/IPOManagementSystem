<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IPOProcessingSystem.Views.FooterView"
             x:Name="FooterSelf">
    <!--
        IsVisible binds to the IsLoggedIn BindableProperty on this ContentView.
        When the user is NOT logged in the bar is completely hidden (zero height).
        BindingContext is set to 'this' in code-behind so {Binding IsLoggedIn} resolves.
    -->
    <Border Stroke="#B0BEC5" StrokeThickness="1" BackgroundColor="#263238" Padding="12,6"
            IsVisible="{Binding IsLoggedIn}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="24">

            <!-- IPO ID -->
            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Label Text="Active IPO ID:" TextColor="#90CAF9" FontAttributes="Bold" FontSize="12" />
                <Label x:Name="IpoIdLabel" Text="---" TextColor="White" FontAttributes="Bold" FontSize="12" />
            </HorizontalStackLayout>

            <!-- Client Name -->
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label Text="Client Name:" TextColor="#B0BEC5" FontSize="12" />
                <Label x:Name="ClientNameLabel" Text="---" TextColor="White" FontAttributes="Bold"
                       FontSize="12" LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>

            <!-- Login By -->
            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                <Label Text="Login By:" TextColor="#B0BEC5" FontSize="12" />
                <Label x:Name="LoginByLabel" Text="---" TextColor="#A5D6A7" FontAttributes="Bold" FontSize="12" />
            </HorizontalStackLayout>

            <!-- Version -->
            <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                <Label Text="Version:" TextColor="#B0BEC5" FontSize="12" />
                <Label x:Name="VersionLabel" Text="1.0.0" TextColor="#FFE082" FontSize="12" />
            </HorizontalStackLayout>

        </Grid>
    </Border>
</ContentView>
