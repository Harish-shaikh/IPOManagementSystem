<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IPOProcessingSystem.ViewModels"
             xmlns:models="clr-namespace:IPOProcessingSystem.Models"
             x:Class="IPOProcessingSystem.Views.ReconciliationPage"
             x:DataType="vm:ReconciliationViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">
        <!-- Header Controls -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Bank Reconciliation (T+2)" Style="{StaticResource SectionHeader}" />

            <!-- Top Toolbar -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Load Banks" Command="{Binding LoadBanksCommand}" />
                <Entry Grid.Column="1" Text="{Binding SelectedBankCode}" Placeholder="Bank Code (e.g. AXIS, HDFC, SBI)" />
                <Button Grid.Column="2" Text="Run Reconciliation" Command="{Binding RunReconciliationCommand}" BackgroundColor="{StaticResource Primary}" />
                <Button Grid.Column="3" Text="Mark NIL Bank" Command="{Binding MarkBankNilCommand}" BackgroundColor="Crimson" />
            </Grid>

            <!-- File Upload Bar -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding FilePath}" Placeholder="Bank schedule file (.xlsx / .csv)" IsReadOnly="True" />
                <Button Grid.Column="1" Text="Browse" Command="{Binding BrowseCommand}" />
                <Button Grid.Column="2" Text="Display Content" Command="{Binding DisplayContentCommand}" />
            </Grid>

            <!-- Summary KPI Badges -->
            <HorizontalStackLayout Spacing="16" BackgroundColor="#F0F4F8" Padding="10">
                <Label Text="{Binding TotalRecords, StringFormat='Total Records: {0}'}" FontAttributes="Bold" />
                <Label Text="{Binding MatchedRecords, StringFormat='Matched: {0}'}" TextColor="ForestGreen" FontAttributes="Bold" />
                <Label Text="{Binding UnmatchedRecords, StringFormat='Unmatched: {0}'}" TextColor="Crimson" FontAttributes="Bold" />
                <Label Text="{Binding TotalAmount, StringFormat='Total Amt: ₹{0:N2}'}" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Accent}" FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- Main Body: Tabs or Split Views -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <!-- Left Side: Unmatch & Rejections -->
            <Border Grid.Column="0" Stroke="#CCCCCC" StrokeThickness="1" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Unmatched Applications (Applnsx vs Schedule)" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding ApplnsxUnmatch}" HeightRequest="260">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="80,100,*,Auto" Padding="4" BackgroundColor="{StaticResource Primary}">
                                <Label Text="Form No" TextColor="White" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="Amount" TextColor="White" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="Reason" TextColor="White" FontAttributes="Bold" />
                                <Label Grid.Column="3" Text="Action" TextColor="White" FontAttributes="Bold" />
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:UnmatchRecord">
                                <Grid ColumnDefinitions="80,100,*,Auto" Padding="4">
                                    <Label Text="{Binding FormNo}" />
                                    <Label Grid.Column="1" Text="{Binding ExcelAmount, StringFormat='₹{0:N0}'}" />
                                    <Label Grid.Column="2" Text="{Binding UnmatchType}" />
                                    <Button Grid.Column="3" Text="Reject" BackgroundColor="Crimson"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReconciliationViewModel}}, Path=RejectUnmatchRecordCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Search and Update -->
                    <Label Text="Search &amp; Update Bank Code" FontAttributes="Bold" Margin="0,10,0,0" />
                    <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="6">
                        <Entry Grid.Column="0" Text="{Binding SearchFormNo}" Placeholder="Form / Order No" />
                        <Button Grid.Column="1" Text="Search" Command="{Binding SearchCommand}" />
                        <Entry Grid.Column="2" Text="{Binding UpdateBankCode}" Placeholder="New Bank Code" />
                        <Button Grid.Column="3" Text="Update" Command="{Binding UpdateBankCodeCommand}" BackgroundColor="ForestGreen" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Right Side: Bank Reconciliation Status Lists -->
            <Border Grid.Column="1" Stroke="#CCCCCC" StrokeThickness="1" Padding="10">
                <Grid RowDefinitions="*,*" RowSpacing="10">
                    <VerticalStackLayout Grid.Row="0">
                        <Label Text="Pending Banks" FontAttributes="Bold" TextColor="DarkOrange" />
                        <CollectionView ItemsSource="{Binding PendingBanks}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" Padding="6" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1">
                        <Label Text="Completed Banks" FontAttributes="Bold" TextColor="ForestGreen" />
                        <CollectionView ItemsSource="{Binding CompletedBanks}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" Padding="6" TextColor="ForestGreen" FontAttributes="Bold" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
